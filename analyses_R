library(missForest)
library(haven)
library(dplyr)

data <- read_dta("randomforest.dta")
data <- as.data.frame(data)
for (v in names(data)) {
  if (is.labelled(data[[v]])) {
    data[[v]] <- as_factor(data[[v]])
  }
}
bvars <- grep("^b_", names(data), value = TRUE)
factor_vars <- c("b_sex","b_employ","b_livealone","b_digital",
                 "b_edu","b_ltc","b_livepr","b_smoke",
                 "b_drink","b_exercise")
for (v in intersect(factor_vars, names(data))) {
  data[[v]] <- as.factor(data[[v]])
}

savepath <- "data/"

for (c in 1:22) {
  d <- data[data$country == c, ]
  d_b <- d[, bvars, drop = FALSE]
  set.seed(123)
  imp <- missForest(
    d_b,
    ntree = 300,
    maxiter = 10,
    variablewise = FALSE
  )
  d_imp <- d
  d_imp[, bvars] <- imp$ximp
  outfile <- paste0(savepath, "imputed_country_", c, ".dta")
  write_dta(d_imp, outfile) 
}
