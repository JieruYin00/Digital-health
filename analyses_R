#Supplementary Fig. 11
loess_fit3 <- loess(agingall ~ digital, data , span = 0.75, degree = 2, family = "symmetric")
data$agingall_fit <- predict(loess_fit3)
rss3 <- sum((data$agingall - data$agingall_fit)^2)
tss3 <- sum((data$agingall - mean(data$agingall))^2)
pseudo_R23 <- 1 - rss3 / tss3
print(paste0(" R²: ", round(pseudo_R23, 4)))

