label values sex .
replace age=. if age==.m
replace digital=. if digital==.d | digital==.m | digital==.p | digital==.r
replace cesd_con=. if cesd_con==.j
bysort country: egen mean_cesd = mean(cesd_con)
bysort country: egen sd_cesd   = sd(cesd_con)
gen zcesd_con = (cesd_con - mean_cesd) / sd_cesd

gen year=.
replace year=2011 if country==3 & wave==1
replace year=2013 if country==3 & wave==2
replace year=2015 if country==3 & wave==3
replace year=2018 if country==3 & wave==4

replace year=2006 if country==21 & wave==1
replace year=2008 if country==21 & wave==2
replace year=2010 if country==21 & wave==3
replace year=2012 if country==21 & wave==4
replace year=2014 if country==21 & wave==5
replace year=2016 if country==21 & wave==6

replace year=2012 if country==7 & wave==1
replace year=2014 if country==7 & wave==2
replace year=2016 if country==7 & wave==3
replace year=2018 if country==7 & wave==4


replace year=2012 if (country!=7 & country!=22 & country!=3) & wave==1
replace year=2014 if (country!=7 & country!=22 & country!=3) & wave==2
replace year=2016 if (country!=7 & country!=22 & country!=3) & wave==3
replace year=2018 if (country!=7 & country!=22 & country!=3) & wave==4

drop wave
rename year wave
replace study=1 if country==3
replace study=2 if country==21
replace study=3 if country==7
replace study=4 if (country!=15 & country!=7 & country!=22 & country!=3)

save IPW,replace

clear
use IPWCHARLS
gen country=3
save IPWCHARLS,replace

clear
use IPWHRS
gen country=22
save IPWHRS,replace


clear
use IPWELSA
gen country=7
save IPWELSA,replace

clear
use IPWCHARLS
append using IPWHRS
append using IPWELSA
append using IPWSHARE


destring ID,replace
recast long ID
format %14.0g ID
rename wave year
save IPW2

clear
use xcountry_digital1
merge 1:1 ID year country using IPW2
rename _merge merge
keep if merge==3

global demo " b_livealone b_age b_sex b_livepr"
global ses " income_q b_employ b_edu "
global health "b_zcesd_con b_ltc"
global behavior "b_smoke b_drink b_exercise"

forvalues c = 1/21 {
	xtmixed adj_latent_aging_score b_digital##c.cwave $demo $ses $health $behavior if b_age>=50 & b_age!=. & country==`c' [pweight=attrition_ipw]|| pid: cwave, vce(robust)
	asdoc margins, dydx(b_digital), save(ipwaging.doc)
}

forvalues c = 1/21 {
	xtmixed adj_latent_rec_score b_digital##c.cwave $demo $ses $health $behavior if b_age>=50 & b_age!=. & country==`c' [pweight=attrition_ipw] || pid: cwave, vce(robust)
