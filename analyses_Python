def bootstrap_g0_g1(y, d, stat_func, n_boot=1000):
    y = np.asarray(y)
    d = np.asarray(d)
    mask = ~np.isnan(y) & ~np.isnan(d)
    y, d = y[mask], d[mask]
    n = len(y)
    if n < 10:
        return [np.nan]*12  # g0, g0_L, g0_U, g1, g1_L, g1_U, diff, diff_L, diff_U, rel, rel_L, rel_U
    def stats(idx):
        yb, db = y[idx], d[idx]
        g1 = stat_func(yb[db==1])
        g0 = stat_func(yb[db==0])
        diff_abs = g1 - g0
        diff_rel = (g1 - g0)/g0 if g0 != 0 else np.nan
        return g0, g1, diff_abs, diff_rel

    theta_hat = stats(np.arange(n))

    # bootstrap
    boot = np.array([stats(np.random.choice(np.arange(n), n, replace=True)) for _ in range(n_boot)])
    boot_g0, boot_g1, boot_diff, boot_rel = boot[:,0], boot[:,1], boot[:,2], boot[:,3]

    # percentile CI
    def percentile_ci(vals):
        vals = vals[~np.isnan(vals)]
        if len(vals) < 50:
            return [np.nan, np.nan]
        return np.percentile(vals, [2.5, 97.5])

    g0_ci = percentile_ci(boot_g0)
    g1_ci = percentile_ci(boot_g1)
    diff_ci = percentile_ci(boot_diff)
    rel_ci = percentile_ci(boot_rel)

    return [theta_hat[0], g0_ci[0], g0_ci[1],
            theta_hat[1], g1_ci[0], g1_ci[1],
            theta_hat[2], diff_ci[0], diff_ci[1],
            theta_hat[3], rel_ci[0], rel_ci[1]]

def analyze_multiple_scores(df, score_cols, group_col='digital', country_col='country', n_boot=1000):
    results = []
    for country in sorted(df[country_col].dropna().unique()):
        country_data = df[df[country_col]==country]
        n1 = (country_data[group_col]==1).sum()
        n0 = (country_data[group_col]==0).sum()
        if n1 < 5 or n0 < 5:
            continue
        row = {'国家': country, 'digital=1_样本量': n1, 'digital=0_样本量': n0}
        for score in score_cols:
            y = country_data[score].values
            d = country_data[group_col].values
            g0, g0L, g0U, g1, g1L, g1U, diff, diffL, diffU, rel, relL, relU = bootstrap_g0_g1(y, d, calculate_gini, n_boot)
            row.update({
                f'{score}_g0': g0, f'{score}_g0_L': g0L, f'{score}_g0_U': g0U,
                f'{score}_g1': g1, f'{score}_g1_L': g1L, f'{score}_g1_U': g1U,
                f'{score}_diff': diff, f'{score}_diff_L': diffL, f'{score}_diff_U': diffU,
                f'{score}_rel': rel, f'{score}_rel_L': relL, f'{score}_rel_U': relU
            })
        results.append(row)
    return pd.DataFrame(results)


if __name__ == "__main__":
    file_path = 'gini.xlsx'
    df = pd.read_excel(file_path)
    score_cols = ['adj_latent_aging_score','adj_latent_cog_score','adj_latent_func_score','adj_latent_health_score']
    results_df = analyze_multiple_scores(df, score_cols, group_col='digital', country_col='country', n_boot=1000)
